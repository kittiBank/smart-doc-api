APP_NAME=smart-doc-api
APP_ENV=local

# Postgres (docker-compose)
POSTGRES_USER=smartdoc
POSTGRES_PASSWORD=smartdoc
POSTGRES_DB=smartdoc
DATABASE_URL=postgresql+psycopg://smartdoc:smartdoc@localhost:5432/smartdoc

# Ollama (runs natively on the host)
OLLAMA_BASE_URL=http://localhost:11434
OCR_MODEL=scb10x/typhoon-ocr1.5-3b
CHAT_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3
